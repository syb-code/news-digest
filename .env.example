# Every setting the news digest reads from its environment, all left empty.
#
# Real values never go in this repository. Put each one where its section
# says: GitHub (Settings > Secrets and variables > Actions, or Settings >
# Environments > digest) or Cloudflare (your Worker > Settings > Variables and
# Secrets). To try a script on your own machine, copy this file to .env, which
# git ignores, and keep the file outside any folder you upload.

# ---- GitHub repository variables (Settings > Secrets and variables > Actions > Variables)

# "true" turns the daily workflow on. Any other value, or none, keeps every job
# off, which is how a fresh copy of this repository starts.
DIGEST_ENABLED=
# Your Worker's address, such as https://name.your-subdomain.workers.dev, with
# no path. The deploy job writes it into the published dashboard only. Empty
# turns the summaries off.
WORKER_URL=
# Optional. The dashboard's address, used for the briefing links in the email.
# Default: https://<owner>.github.io/<repository>/
SITE_URL=

# ---- GitHub secrets in the "digest" environment (deployment branches: main only)

# Claude, for the morning briefing (scripts/learn/brief.py). Without it the
# briefing is built from the headlines alone.
ANTHROPIC_API_KEY=
# Gmail, for the morning email (scripts/send_email.py). See
# scripts/oauth_local_example.py for how to mint a send-only refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SENDER_EMAIL=
RECIPIENT_EMAIL=

# ---- Set by GitHub Actions in every run (only for a local run of send_email.py)

# The job's own token; send_email.py uses it read-only to find when this run
# was created and which earlier morning run sent its email.
GITHUB_TOKEN=
# owner/name of the repository.
GITHUB_REPOSITORY=
GITHUB_RUN_ID=
# Set by the workflow to "fallback" when the email is built from the data
# committed on main because the refresh failed.
DIGEST_DATA=
# Set by the workflow on the morning run: seconds the feeds may take in all
# (30 to 360, default 360), so the email is not held up by slow sources.
FEED_RUN_SECONDS=

# ---- Cloudflare Worker (your Worker > Settings > Variables and Secrets)

# Secret. The key the dashboard sends to the Worker (worker/auth-guard.js).
ACCESS_KEY=
# Text. The origin of your dashboard, such as https://your-name.github.io
# (scheme and host only, no path). The Worker answers a browser on any other
# site with 403. Several origins are separated by commas.
ALLOWED_ORIGINS=
# Secret. A fine-grained GitHub token for this one repository with Actions:
# read and write and nothing else. It starts the daily runs
# (worker/scheduler.js) and the edits of the X accounts (worker/sources.js).
GH_DISPATCH_TOKEN=
# Text. owner/name of this repository.
GH_REPO=
